#######################
# Required parameters #
#######################
#IP address where the controller will listen for workers' connections
controller.listening.ip = 127.0.0.1

#Port number where the controller will listen for workers' connections
controller.listening.port = 12000

#Number of machines/workers
global.worker.machines = <number of worker machines>

#Controller benchmark strategy class implementing IBenchmarkStrategy
controller.benchmark.strategy = confidential.benchmark.auto.ThroughputLatencyBenchmarkStrategy

#Worker setup class implementing ISetupWorker
controller.worker.setup = confidential.benchmark.auto.MeasurementSetup

#Worker event processor class implementing IWorkerEventProcessor
controller.worker.processor = confidential.benchmark.auto.MeasurementEventProcessor

#############################################################################
# Extra parameters provided in IBenchmarkStrategy through Properties object #
#############################################################################
# Fault threshold (>= 0)
experiment.f = 1

# Space separated list of number of clients per round
experiment.clients_per_round = 1 5 10 15 25 40 50

# Size of public data sent in each request (in bytes)
experiment.request.plain_data_size = 256

# Size of private data sent in each request (in bytes)
experiment.request.private_data_size = 256

# Size of public data received in each response (in bytes)
experiment.response.plain_data_size = 256

# Size of private data received in each response (in bytes)
experiment.response.private_data_size = 0

# If true, send requests using consensus (true or false)
experiment.send_ordered_request = true

# If true, use hashed responses to reduce response size (true or false)
experiment.use_hashed_response = false

# Path to file containing IP addresses and ports of servers (BFT-SMaRt hosts)
experiment.hosts.file = config/hosts.config

# Measure resource usage (CPU, memory, and network) (true or false)
experiment.measure_resources = true

# Duration of each measurement in seconds
experiment.measurement_duration = 360